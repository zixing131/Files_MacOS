<UserControl
	x:Class="Files.App.MacOS.Controls.ComputerPageView" Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.App.MacOS.Controls">
	<UserControl.Resources>
		<Style x:Key="ComputerCardStyle" TargetType="ToggleButton">
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Stretch" />
			<Setter Property="Padding" Value="4" />
			<Setter Property="Margin" Value="3" />
			<Setter Property="UseSystemFocusVisuals" Value="False" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border x:Name="CardBorder" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
							<ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<DataTemplate x:Key="VolumeTemplate">
			<ToggleButton Style="{StaticResource ComputerCardStyle}" Click="Card_Click" Checked="Card_Checked" Unchecked="Card_Unchecked" Loaded="Card_Loaded" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" DoubleTapped="Card_DoubleTapped" KeyDown="Card_KeyDown" HorizontalAlignment="Stretch">
			<Grid HorizontalAlignment="Stretch" Height="76" Padding="4" ColumnDefinitions="54,*" ColumnSpacing="10" AutomationProperties.Name="{Binding AccessibleName}">
				<Viewbox Width="52" Height="52" VerticalAlignment="Center">
					<Canvas Width="64" Height="64">
						<Path Data="M7,35 L17,16 H47 L57,35 Z" Fill="#D9DEE4" />
						<Path Data="M7,35 H57 V50 Q57,53 54,53 H10 Q7,53 7,50 Z" Fill="#9AA4AF" />
						<Path Data="M10,37 H54 V49 H10 Z" Fill="#404B58" />
						<Rectangle Canvas.Left="13" Canvas.Top="41" Width="5" Height="4" RadiusX="1" RadiusY="1" Fill="#76DB6B" />
						<Path Data="M12,33 L20,19 H44 L52,33 Z" Fill="#EEF1F5" />
					</Canvas>
				</Viewbox>
				<StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
					<TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
					<controls:VolumeCapacityBar Percentage="{Binding UsedPercentage}" Visibility="{Binding HasCapacity, Converter={StaticResource BooleanToVisibilityConverter}}" />
					<TextBlock Text="{Binding CapacityText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
				</StackPanel>
			</Grid>
					</ToggleButton>
		</DataTemplate>
		<DataTemplate x:Key="FavoriteTemplate">
			<ToggleButton Style="{StaticResource ComputerCardStyle}" Click="Card_Click" Checked="Card_Checked" Unchecked="Card_Unchecked" Loaded="Card_Loaded" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" DoubleTapped="Card_DoubleTapped" KeyDown="Card_KeyDown" HorizontalAlignment="Stretch">
			<Grid HorizontalAlignment="Stretch" Height="56" Padding="6" ColumnDefinitions="40,*" ColumnSpacing="12">
				<controls:SidebarItemIcon Glyph="{Binding Glyph}" Width="32" Height="32" />
				<TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
			</Grid>
					</ToggleButton>
		</DataTemplate>
		<DataTemplate x:Key="FavoriteDetailsTemplate">
			<ToggleButton Style="{StaticResource ComputerCardStyle}" Click="Card_Click" Checked="Card_Checked" Unchecked="Card_Unchecked" Loaded="Card_Loaded" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" DoubleTapped="Card_DoubleTapped" KeyDown="Card_KeyDown" HorizontalAlignment="Stretch">
				<Grid Height="32" ColumnDefinitions="28,*" ColumnSpacing="10" Padding="4,0">
					<controls:SidebarItemIcon Glyph="{Binding Glyph}" Width="24" Height="24" />
					<TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
				</Grid>
			</ToggleButton>
		</DataTemplate>
		<DataTemplate x:Key="VolumeDetailsTemplate">
			<ToggleButton Style="{StaticResource ComputerCardStyle}" Click="Card_Click" Checked="Card_Checked" Unchecked="Card_Unchecked" Loaded="Card_Loaded" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" DoubleTapped="Card_DoubleTapped" KeyDown="Card_KeyDown" HorizontalAlignment="Stretch">
				<Grid MinHeight="40" ColumnDefinitions="28,*,*" ColumnSpacing="10" Padding="4,0" AutomationProperties.Name="{Binding AccessibleName}">
					<controls:SidebarItemIcon Glyph="◉" Width="24" Height="24" />
					<TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
					<TextBlock Grid.Column="2" Text="{Binding CapacityText}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding CapacityText}" />
				</Grid>
			</ToggleButton>
		</DataTemplate>
		<ItemsPanelTemplate x:Key="DetailsPanel"><StackPanel /></ItemsPanelTemplate>
		<ItemsPanelTemplate x:Key="VolumesPanel">
			<controls:VolumeWrapPanel />
		</ItemsPanelTemplate>
	</UserControl.Resources>
	<ScrollViewer x:Name="PageScroller" Background="Transparent" VerticalScrollMode="Enabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
		<StackPanel Background="Transparent" Padding="12,12,12,24" Spacing="12">
			<Button x:Name="FavoritesHeading" Click="ToggleGroup_Click" Tag="Favorites" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource FilesFlatButtonStyle}">
				<StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding ComputerFavoritesChevron}" /><TextBlock x:Uid="ComputerFavoritesHeading" Foreground="{ThemeResource FilesAccentBrush}" /></StackPanel>
			</Button>
			<ItemsControl x:Name="FavoriteCards" ItemsSource="{Binding ComputerFavorites}" ItemTemplate="{StaticResource FavoriteTemplate}" ItemsPanel="{StaticResource VolumesPanel}"
				HorizontalAlignment="Stretch" Visibility="{Binding ComputerFavoritesExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
			<Button x:Name="DevicesHeading" Click="ToggleGroup_Click" Tag="Devices" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource FilesFlatButtonStyle}">
				<StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding ComputerDevicesChevron}" /><TextBlock x:Uid="ComputerDevicesHeading" Foreground="{ThemeResource FilesAccentBrush}" /></StackPanel>
			</Button>
			<ItemsControl x:Name="DeviceCards" ItemsSource="{Binding LocalVolumes}" ItemTemplate="{StaticResource VolumeTemplate}" ItemsPanel="{StaticResource VolumesPanel}"
				HorizontalAlignment="Stretch" Visibility="{Binding ComputerDevicesExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
			<StackPanel Spacing="8" Visibility="{Binding HasNetworkVolumes, Converter={StaticResource BooleanToVisibilityConverter}}">
				<Button x:Name="NetworkHeading" Click="ToggleGroup_Click" Tag="Network" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource FilesFlatButtonStyle}">
					<StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding ComputerNetworkChevron}" /><TextBlock x:Uid="ComputerNetworkHeading" Foreground="{ThemeResource FilesAccentBrush}" /></StackPanel>
				</Button>
				<ItemsControl x:Name="NetworkCards" ItemsSource="{Binding NetworkVolumes}" ItemTemplate="{StaticResource VolumeTemplate}" ItemsPanel="{StaticResource VolumesPanel}"
				HorizontalAlignment="Stretch" Visibility="{Binding ComputerNetworkExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
			</StackPanel>
			<TextBlock x:Uid="ComputerNoVolumes" Margin="16,12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding HasNoVolumes, Converter={StaticResource BooleanToVisibilityConverter}}" />
		</StackPanel>
	</ScrollViewer>
</UserControl>
